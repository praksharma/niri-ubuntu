#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/.cargo
NCPU := $(shell nproc)

DEB_VERSION := $(shell dpkg-parsechangelog -S Version)
UPSTREAM_VERSION := $(shell echo $(DEB_VERSION) | sed 's/-[^-]*$$//')
BASE_VERSION := $(shell echo $(UPSTREAM_VERSION) | sed 's/ppa[0-9]*$$//')

%:
	dh $@

override_dh_auto_build:
	test -d niri-$(BASE_VERSION) || (echo "ERROR: niri-$(BASE_VERSION) source directory not found!" && exit 1)

	# dpkg-source omits files such as .gitignore from native source archives.
	# Clear per-file vendor checksums while preserving each crate package hash.
	for checksum in niri-$(BASE_VERSION)/vendor/*/.cargo-checksum.json; do \
		if [ -f "$$checksum" ]; then \
			pkg=$$(grep -o '"package":"[^"]*"' "$$checksum" | cut -d'"' -f4); \
			printf '{"files":{},"package":"%s"}\n' "$$pkg" > "$$checksum"; \
		fi; \
	done

	cd niri-$(BASE_VERSION) && \
		RUSTC=rustc-1.80 cargo-1.80 build --offline --release --features default -j$(NCPU)
	cd niri-$(BASE_VERSION) && \
		for shell in bash fish zsh; do \
			./target/release/niri completions $$shell > $$shell-completions; \
		done

override_dh_auto_install:
	install -Dm755 niri-$(BASE_VERSION)/target/release/niri debian/niri/usr/bin/niri
	install -Dm755 niri-$(BASE_VERSION)/resources/niri-session debian/niri/usr/bin/niri-session
	install -Dm644 niri-$(BASE_VERSION)/resources/niri.service debian/niri/usr/lib/systemd/user/niri.service
	install -Dm644 niri-$(BASE_VERSION)/resources/niri-shutdown.target debian/niri/usr/lib/systemd/user/niri-shutdown.target
	install -Dm644 niri-$(BASE_VERSION)/resources/niri.desktop debian/niri/usr/share/wayland-sessions/niri.desktop
	install -Dm644 niri-$(BASE_VERSION)/resources/niri-portals.conf debian/niri/usr/share/xdg-desktop-portal/niri-portals.conf
	install -Dm644 niri-$(BASE_VERSION)/resources/default-config.kdl debian/niri/usr/share/doc/niri/default-config.kdl
	install -Dm644 niri-$(BASE_VERSION)/README.md debian/niri/usr/share/doc/niri/README.md
	install -Dm644 niri-$(BASE_VERSION)/bash-completions debian/niri/usr/share/bash-completion/completions/niri
	install -Dm644 niri-$(BASE_VERSION)/fish-completions debian/niri/usr/share/fish/vendor_completions.d/niri.fish
	install -Dm644 niri-$(BASE_VERSION)/zsh-completions debian/niri/usr/share/zsh/site-functions/_niri

override_dh_auto_clean:
	rm -rf .cargo
	if [ -d niri-$(BASE_VERSION) ]; then \
		cd niri-$(BASE_VERSION) && RUSTC=rustc-1.80 cargo-1.80 clean 2>/dev/null || true; \
	fi
	dh_auto_clean

override_dh_clean:
	dh_clean -XCargo.toml.orig -X.orig
